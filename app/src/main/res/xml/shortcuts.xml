<?xml version="1.0" encoding="utf-8"?>
<!-- 共有シートに、最近送ったチャンネルを直接の送り先として出す (#25)。ショートカット自体はアプリが送信時に登録する (ChannelShortcuts) -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.giracle.android.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="com.giracle.android.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
