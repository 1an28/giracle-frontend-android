<?xml version="1.0" encoding="utf-8"?>
<!-- セルフホスト型のため LAN 内の http サーバーにも接続できるようにする -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
